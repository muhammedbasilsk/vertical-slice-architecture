# Database Configuration
# For Docker: use the PostgreSQL container hostname
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/vertical_slice_db

# For local development: use localhost
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vertical_slice_db

# API Configuration
API_VERSION=v1

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vertical_slice_db
